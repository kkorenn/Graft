{
	"schemaVersion": 1,
	"id": "graft",
	"version": "${version}",
	"name": "Graft",
	"description": "Native Apple Metal renderer: replaces Minecraft's OpenGL device with Metal.",
	"license": "MIT",
	"environment": "client",
	"icon": "assets/graft/icon.png",
	"entrypoints": { "sodium:config_api_user": ["dev.graft.v1_21_11.compat.SodiumOptions"] },
	"mixins": ["graft.mixins.json", "graft.sodium.mixins.json"],
	"depends": { "fabricloader": ">=0.19.5", "minecraft": "1.21.11", "java": ">=25" },
	"breaks": { "metallum": "*" }
}
